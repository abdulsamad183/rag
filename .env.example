# ============================================================
# Adaptive Evidence-Driven RAG Engine — environment template
# Copy to .env and fill in what you use. Never commit .env.
# ============================================================

# ----- LLM provider credentials (leave empty to disable a provider) -----
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Ollama runs locally; no key needed. Point at your Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Optional base-URL overrides (e.g. proxies, Azure-compatible gateways)
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ----- Default provider / models -----
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=

OPENAI_DEFAULT_MODEL=gpt-4o-mini
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
OLLAMA_DEFAULT_MODEL=llama3.2

# ----- Embeddings -----
# provider: openai | gemini | ollama
DEFAULT_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ----- Reranking: none | lexical | llm -----
RERANKER=lexical
RERANK_TOP_K=8

# ----- Retrieval defaults -----
RETRIEVAL_STRATEGY=hybrid
TOP_K=10
CANDIDATE_POOL_SIZE=30
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RRF_K=60
MAX_HOPS=3
MAX_CORRECTION_ROUNDS=2

# ----- Chunking defaults -----
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ----- Generation defaults -----
TEMPERATURE=0.1
MAX_TOKENS=1024
MAX_CONTEXT_TOKENS=6000

# ----- Confidence / abstention -----
CONFIDENCE_HIGH=0.75
CONFIDENCE_MEDIUM=0.55
CONFIDENCE_LOW=0.35
ABSTAIN_THRESHOLD=0.35

# ----- Infrastructure -----
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
# Run background jobs inline (no worker/redis needed) — dev only
INLINE_JOBS=false

# ----- Files / storage -----
STORAGE_BACKEND=local
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=50

# ----- HTTP / resilience -----
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0

# ----- Rate limits (requests per minute; 0 disables) -----
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_CHAT=30
RATE_LIMIT_UPLOADS=20
RATE_LIMIT_EVALUATIONS=6

# ----- Security / app -----
SECRET_KEY=change-me
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO
JSON_LOGS=false
ENVIRONMENT=development

# ----- Privacy -----
# local mode restricts generation+embeddings to Ollama. Web search is separate:
# it only runs when the chat composer picks KB + Web or Web only.
LOCAL_MODE=false
# none | ddg  (ddg = DuckDuckGo HTML scrape + page excerpts, no API key)
WEB_SEARCH_PROVIDER=ddg
